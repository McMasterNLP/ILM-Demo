# Host-facing URL. Compose publishes Postgres on 5433 to avoid clashing
# with a local install on 5432; the container overrides this with db:5432.
DATABASE_URL=postgresql+psycopg://ilm:ilm@localhost:5433/ilm
CORS_ORIGINS=http://localhost:5173
API_PREFIX=/api/v1

# Curation admin. Login is refused while ADMIN_PASSWORD is empty.
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=change-me

# Question generation (Gemini). Writes questions only, never story text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Doubles the API calls per question. Off by default.
GENERATE_FOLLOWUPS=false

# Authoring
UPLOAD_DIR=./storage/uploads

# Retrieval (Cohere). Blank key disables embedding and search.
COHERE_API_KEY=
EMBEDDING_MODEL=embed-multilingual-v3.0
EMBED_BATCH_SIZE=96
# Reranking stays off until retrieval quality is measurably the problem.
RERANK_ENABLED=false
RERANK_MODEL=rerank-multilingual-v3.0
RERANK_CANDIDATES=50
# Flags a generated question that resembles one already in the bank.
# Warns a reviewer; never rejects.
SIMILARITY_WARNING=0.78

# Logs every SQL statement.
SQL_ECHO=false

# External KG/ML service
# During local development, localhost:8765 is forwarded to ada via SSH.
KG_ML_URL=http://127.0.0.1:8765
KG_ML_TIMEOUT_SECONDS=300
